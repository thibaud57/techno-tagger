{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions de la fenetre principale : lancement du sidecar, selection de chemins, preferences, locale et ouverture de dossiers.",
  "windows": ["main"],
  "platforms": ["windows"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/tagger", "sidecar": true }]
    },
    "shell:allow-stdin-write",
    "dialog:allow-open",
    "fs:allow-applocaldata-read-recursive",
    "fs:allow-applocaldata-write-recursive",
    "store:default",
    "os:allow-locale",
    "opener:allow-reveal-item-in-dir",
    "opener:allow-open-url",
    "opener:allow-default-urls"
  ]
}
