{
  "python.defaultInterpreterPath": "${workspaceFolder}/sidecar/.venv/Scripts/python.exe",
  // L'analyseur CSS integre ne connait pas les at-rules de Tailwind 4.
  "css.lint.unknownAtRules": "ignore",
  "files.exclude": {
    "**/.history": true
  },
  "search.exclude": {
    "**/.history": true,
    "**/node_modules": true,
    "**/.venv": true,
    "**/dist": true,
    "**/src-tauri/target": true,
    "**/.angular": true,
    "**/coverage": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.pytest_cache": true,
    "**/pnpm-lock.yaml": true,
    "**/uv.lock": true,
    "**/Cargo.lock": true
  },
  "files.watcherExclude": {
    "**/.history/**": true,
    "**/node_modules/**": true,
    "**/.venv/**": true,
    "**/src-tauri/target/**": true,
    "**/.angular/**": true,
    "**/coverage/**": true,
    "**/.mypy_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.pytest_cache/**": true
  },
  "python.analysis.extraPaths": ["./sidecar/tests/helpers"]
}
