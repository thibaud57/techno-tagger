# Copier en .env (jamais commite). Uniquement des secrets de build : la cle API
# vit dans le trousseau de l'OS et l'URL de l'API dans le store Tauri.

# DSN vide = SDK inerte, seul moyen de ne pas polluer Sentry en developpement.
SENTRY_DSN_SIDECAR=
SENTRY_DSN_UI=

# Requise meme en Community : sans elle une notice s'affiche chez l'utilisateur.
PRIMENG_LICENSE_KEY=
