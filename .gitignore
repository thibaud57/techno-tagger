# --- Secrets & environnement ---
.env
.env.*
!.env.example
*.local
# Permissions validees localement, propres a la machine. Ne matche pas *.local
.claude/settings.local.json

# --- Angular / Node (src/) ---
node_modules/
/dist/
.angular/
*.tsbuildinfo
coverage/

# --- Python (sidecar/) ---
__pycache__/
*.py[cod]
.venv/
sidecar/build/
sidecar/dist/
# Grave par build.py au packaging : porte le DSN Sentry, regenere a chaque build
sidecar/src/tagger/_build_info.py
# tagger.spec n'est PAS ignore : build.py l'invoque par son nom et il porte
# trois hidden imports ecrits a la main. Sans lui, aucun build sur un clone frais.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Rust / Tauri (src-tauri/) ---
src-tauri/target/
src-tauri/gen/

# Le sidecar PyInstaller est produit au build, jamais commite
src-tauri/binaries/

# --- Signature updater (ne doit jamais etre commitee) ---
*.key
*.pem

# Le sidecar ecrit dans appLocalDataDir, jamais ici. Ceinture si un chemin
# relatif revenait par accident.
logs/

# Snapshots et logs de console poses par le MCP Playwright a chaque navigation
.playwright-mcp/

# --- IDE & OS ---
**/.history/
# On versionne ce qui decrit le projet, pas ce qui decrit la machine
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
Thumbs.db
desktop.ini
