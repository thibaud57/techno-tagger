{
  "name": "techno-tagger-ui",
  "version": "0.4.2",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --define \"PRIMENG_LICENSE_KEY='$PRIMENG_LICENSE_KEY'\" --define \"APP_VERSION='$npm_package_version'\" --define \"SENTRY_DSN_UI='$SENTRY_DSN_UI'\"",
    "build": "ng build --define \"PRIMENG_LICENSE_KEY='$PRIMENG_LICENSE_KEY'\" --define \"APP_VERSION='$npm_package_version'\" --define \"SENTRY_DSN_UI='$SENTRY_DSN_UI'\" --define \"APP_ENVIRONMENT='production'\" && pnpm run sourcemaps",
    "watch": "ng build --watch --configuration development --define \"PRIMENG_LICENSE_KEY='$PRIMENG_LICENSE_KEY'\" --define \"APP_VERSION='$npm_package_version'\" --define \"SENTRY_DSN_UI='$SENTRY_DSN_UI'\"",
    "test": "ng test",
    "lint": "ng lint",
    "sourcemaps": "if [ -n \"$SENTRY_AUTH_TOKEN\" ]; then sentry-cli sourcemaps upload --org \"${SENTRY_ORG:-tg-ws}\" --project \"${SENTRY_PROJECT_UI:-techno-tagger-ui}\" --release \"techno-tagger@$npm_package_version\" dist/$npm_package_name/browser; fi; find dist/$npm_package_name/browser -name '*.map' -delete"
  },
  "dependencies": {
    "@angular/cdk": "22.2.0",
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/forms": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@angular/router": "22.2.0",
    "@fontsource-variable/inter": "5.3.0",
    "@ngx-translate/core": "18.0.0",
    "@ngx-translate/http-loader": "18.0.0",
    "@primeicons/angular": "8.0.2",
    "@primeuix/themes": "3.0.1",
    "@sentry/angular": "11.1.0",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "@tauri-apps/plugin-fs": "2.6.0",
    "@tauri-apps/plugin-opener": "2.7.0",
    "@tauri-apps/plugin-os": "2.4.0",
    "@tauri-apps/plugin-shell": "2.4.0",
    "@tauri-apps/plugin-store": "2.5.0",
    "@tauri-apps/plugin-updater": "2.13.1",
    "primeng": "22.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.5.0",
    "@angular/build": "22.2.0",
    "@angular/cli": "22.2.0",
    "@angular/compiler-cli": "22.2.0",
    "@eslint/js": "^10.0.1",
    "@sentry/cli": "^3.8.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "angular-eslint": "22.5.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.1",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tailwindcss-primeui": "0.6.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "4.1.11"
  }
}
