{
  "name": "techno-tagger-ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "^24.15.0 || ^26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --define \"PRIMENG_LICENSE_KEY='$PRIMENG_LICENSE_KEY'\" --define \"APP_VERSION='$npm_package_version'\" --define \"SENTRY_DSN_UI='$SENTRY_DSN_UI'\"",
    "build": "ng build --define \"PRIMENG_LICENSE_KEY='$PRIMENG_LICENSE_KEY'\" --define \"APP_VERSION='$npm_package_version'\" --define \"SENTRY_DSN_UI='$SENTRY_DSN_UI'\" --define \"APP_ENVIRONMENT='production'\" && pnpm run sourcemaps",
    "watch": "ng build --watch --configuration development --define \"PRIMENG_LICENSE_KEY='$PRIMENG_LICENSE_KEY'\" --define \"APP_VERSION='$npm_package_version'\" --define \"SENTRY_DSN_UI='$SENTRY_DSN_UI'\"",
    "test": "ng test",
    "lint": "ng lint",
    "sourcemaps": "if [ -n \"$SENTRY_AUTH_TOKEN\" ]; then sentry-cli sourcemaps upload --org \"${SENTRY_ORG:-tg-ws}\" --project \"${SENTRY_PROJECT_UI:-techno-tagger-ui}\" --release \"techno-tagger@$npm_package_version\" dist/$npm_package_name/browser; fi; find dist/$npm_package_name/browser -name '*.map' -delete"
  },
  "dependencies": {
    "@angular/cdk": "22.1.4",
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/forms": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@angular/router": "22.1.4",
    "@fontsource-variable/inter": "5.3.0",
    "@ngx-translate/core": "18.0.0",
    "@ngx-translate/http-loader": "18.0.0",
    "@primeicons/angular": "8.0.0",
    "@primeuix/themes": "3.0.0",
    "@sentry/angular": "10.72.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-os": "2.3.2",
    "@tauri-apps/plugin-shell": "2.3.5",
    "@tauri-apps/plugin-store": "2.4.4",
    "@tauri-apps/plugin-updater": "2.10.1",
    "primeng": "22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.1.0",
    "@angular/build": "22.1.6",
    "@angular/cli": "22.1.6",
    "@angular/compiler-cli": "22.1.4",
    "@eslint/js": "^10.0.1",
    "@sentry/cli": "^3.7.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tailwindcss-primeui": "0.6.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "4.1.11"
  }
}
