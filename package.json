{
  "name": "techno-tagger-ui",
  "version": "1.0.1",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "^24.15.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --define \"PRIMENG_LICENSE_KEY='$PRIMENG_LICENSE_KEY'\" --define \"APP_VERSION='$npm_package_version'\" --define \"SENTRY_DSN_UI='$SENTRY_DSN_UI'\"",
    "build": "ng build --define \"PRIMENG_LICENSE_KEY='$PRIMENG_LICENSE_KEY'\" --define \"APP_VERSION='$npm_package_version'\" --define \"SENTRY_DSN_UI='$SENTRY_DSN_UI'\" --define \"APP_ENVIRONMENT='production'\" && pnpm run sourcemaps",
    "build:demo": "ng build --configuration production,demo --define \"PRIMENG_LICENSE_KEY='$PRIMENG_LICENSE_KEY'\" --define \"APP_VERSION='$npm_package_version'\" --define \"APP_ENVIRONMENT='demo'\"",
    "start:demo": "ng serve --configuration demo --define \"PRIMENG_LICENSE_KEY='$PRIMENG_LICENSE_KEY'\" --define \"APP_VERSION='$npm_package_version'\"",
    "watch": "ng build --watch --configuration development --define \"PRIMENG_LICENSE_KEY='$PRIMENG_LICENSE_KEY'\" --define \"APP_VERSION='$npm_package_version'\" --define \"SENTRY_DSN_UI='$SENTRY_DSN_UI'\"",
    "test": "ng test",
    "lint": "ng lint",
    "sourcemaps": "if [ -n \"$SENTRY_AUTH_TOKEN\" ]; then sentry-cli sourcemaps upload --org \"${SENTRY_ORG:-tg-ws}\" --project \"${SENTRY_PROJECT_UI:-techno-tagger-ui}\" --release \"techno-tagger@$npm_package_version\" dist/$npm_package_name/browser || echo '::warning::sentry source maps upload failed, this release will report minified stacks'; fi; find dist/$npm_package_name/browser -name '*.map' -delete; left=$(find dist/$npm_package_name/browser -name '*.map' | wc -l); echo \"source maps left after purge: $left\"; test \"$left\" -eq 0"
  },
  "dependencies": {
    "@angular/cdk": "22.2.2",
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "@fontsource-variable/inter": "5.3.0",
    "@ngx-translate/core": "18.0.0",
    "@ngx-translate/http-loader": "18.0.0",
    "@primeicons/angular": "8.0.2",
    "@primeuix/themes": "3.0.1",
    "@sentry/angular": "11.6.0",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "@tauri-apps/plugin-opener": "2.7.0",
    "@tauri-apps/plugin-os": "2.4.0",
    "@tauri-apps/plugin-shell": "2.4.1",
    "@tauri-apps/plugin-store": "2.5.0",
    "@tauri-apps/plugin-updater": "2.14.0",
    "primeng": "22.1.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.5.0",
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@eslint/js": "^10.0.1",
    "@sentry/cli": "^3.8.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "angular-eslint": "22.5.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tailwindcss-primeui": "0.6.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "5.0.3"
  }
}
